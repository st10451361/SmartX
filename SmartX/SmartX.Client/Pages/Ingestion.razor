@page "/ingestion"
@using System.Net.Http.Json
@inject HttpClient Http

<h3 class="mt-4">Telemetry Dashboard</h3>

<!-- PROACTIVE ALERT GAMIFICATION (Research Strategy implemented) -->
<div class="alert @(SystemHealth > 80 ? "alert-success" : "alert-danger") shadow">
    <h4 class="alert-heading">System Health Score: @SystemHealth%</h4>
    @if (SystemHealth <= 80)
    {
        <p class="mb-0"><strong>Warning!</strong> Anomalies detected. Please check sensor grid.</p>
    }
</div>

<div class="row mt-4">
    <!-- Sensor Registration Form -->
    <div class="col-md-4">
        <div class="card shadow p-3">
            <h4>Register Sensor</h4>
            <EditForm Model="@newSensor" OnValidSubmit="RegisterSensor">
                <div class="mb-2">
                    <InputText placeholder="MAC Address" @bind-Value="newSensor.MacAddress" class="form-control" />
                </div>
                <div class="mb-2">
                    <InputNumber placeholder="Zone ID" @bind-Value="newSensor.ZoneId" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary w-100">Register Sensor</button>
            </EditForm>

            <hr />

            <h5>Attach Hardware Log</h5>
            <InputFile OnChange="HandleFileSelected" class="form-control" />
            @if (!string.IsNullOrEmpty(uploadMessage))
            {
                <p class="text-success mt-2">@uploadMessage</p>
            }
        </div>
    </div>

    <!-- Live Telemetry Feed -->
    <div class="col-md-8">
        <div class="card shadow p-3">
            <h4>Live Feed</h4>
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr><th>MAC Address</th><th>Reading Value</th><th>Status</th></tr>
                </thead>
                <tbody>
                    @foreach (var reading in TelemetryReadings)
                    {
                        <tr class="@(reading.IsAnomaly ? "table-danger" : "")">
                            <td>@reading.MacAddress</td>
                            <td>@reading.Value</td>
                            <td>@(reading.IsAnomaly ? " SPIKE DETECTED" : " Normal")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private int SystemHealth = 100;
    private string uploadMessage = "";
    private List<TelemetryView> TelemetryReadings = new();
    private SensorRegistration newSensor = new();

    protected override async Task OnInitializedAsync()
    {
        // Simulate receiving real-time data to prove the UI works under load
        await Task.Run(async () =>
        {
            for (int i = 0; i < 15; i++)
            {
                await Task.Delay(1500); // Simulate network delay

                // Simulate a data spike at reading 5
                var isSpike = i == 5;

                TelemetryReadings.Add(new TelemetryView
                {
                    MacAddress = $"00:1B:44:11:3A:{i:D2}",
                    Value = isSpike ? 999.9 : 24.5,
                    IsAnomaly = isSpike
                });

                if (isSpike) SystemHealth -= 25; // Gamification penalty
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task RegisterSensor()
    {
        var packet = new { MacAddress = newSensor.MacAddress, Payload = 0.0 };
        await Http.PostAsJsonAsync("api/telemetry/ingest", packet);

        TelemetryReadings.Add(new TelemetryView { MacAddress = newSensor.MacAddress, Value = 0.0, IsAnomaly = false });
        newSensor = new SensorRegistration();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            uploadMessage = "Uploading...";
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10485760);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                byte[] fileBytes = ms.ToArray();
                string base64String = Convert.ToBase64String(fileBytes);

                var payload = new
                {
                    MacAddress = "00:1B:44:11:3A:00",
                    FileName = file.Name,
                    Base64Data = base64String
                };

              
                var response = await Http.PostAsJsonAsync("api/telemetry/upload-log", payload);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<UploadResult>();
                    uploadMessage = result?.message ?? "Upload successful!";
                }
                else
                {
                    var errorText = await response.Content.ReadAsStringAsync();
                    uploadMessage = $"Failed: {errorText}";
                }
            }
            catch (Exception ex)
            {
                uploadMessage = $"Network Error: {ex.Message}";
            }
            StateHasChanged();
        }
    }

    public class UploadResult { public string message { get; set; } = ""; }

    public class TelemetryView { public string MacAddress { get; set; } = ""; public double Value { get; set; } public bool IsAnomaly { get; set; } }
    public class SensorRegistration { public string MacAddress { get; set; } = ""; public int ZoneId { get; set; } }
}